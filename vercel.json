{
  "redirects": [
    { "source": "/", "destination": "/app", "permanent": false }
  ],
  "rewrites": [
    { "source": "/app/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/app/cleanerlogo.jpg", "destination": "/cleanerlogo.jpg" },
    { "source": "/app/(.*)", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" }
  ]
}